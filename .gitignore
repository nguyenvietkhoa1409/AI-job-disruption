# Data (raw/processed/quarantine are never committed, per project data policy)
data/raw/*
data/processed/*
data/quarantine/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/quarantine/.gitkeep

# Secrets / environment
.env
*.env
secrets/

# Airflow runtime artifacts
airflow/logs/
airflow.db
airflow-webserver.pid
standalone_admin_password.txt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Exploratory notebooks (scratch analysis, not reviewed/pipeline code)
notebooks/

